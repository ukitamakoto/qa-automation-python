{
  "info": {
    "name": "Restful-Booker",
    "description": "Auth and booking CRUD for https://restful-booker.herokuapp.com. Requests run in order and share the token and booking id through collection variables. Tests named 'known defect' assert the current wrong behaviour and point to the report in docs/bugs, so the run fails when the defect is fixed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "payload",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth: valid credentials return a token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const token = pm.response.json().token;",
              "pm.test('a token is issued', () => pm.expect(token).to.be.a('string').and.not.be.empty);",
              "pm.collectionVariables.set('token', token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"password123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Auth: wrong credentials are refused",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('no token is issued', () => pm.expect(body).to.not.have.property('token'));",
              "pm.test('the reason is Bad credentials', () => pm.expect(body.reason).to.eql('Bad credentials'));",
              "pm.test('known defect BUG-009: answers 200 instead of 401', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"wrong\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Booking: create",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const payload = {",
              "  firstname: 'Ana',",
              "  lastname: 'Newman' + Date.now(),",
              "  totalprice: 150,",
              "  depositpaid: true,",
              "  bookingdates: { checkin: '2026-11-01', checkout: '2026-11-05' },",
              "  additionalneeds: 'Breakfast'",
              "};",
              "pm.collectionVariables.set('payload', JSON.stringify(payload));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const schema = {",
              "  type: 'object',",
              "  required: ['bookingid', 'booking'],",
              "  properties: {",
              "    bookingid: { type: 'integer' },",
              "    booking: {",
              "      type: 'object',",
              "      required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
              "      properties: {",
              "        firstname: { type: 'string' },",
              "        lastname: { type: 'string' },",
              "        totalprice: { type: 'number' },",
              "        depositpaid: { type: 'boolean' },",
              "        bookingdates: {",
              "          type: 'object',",
              "          required: ['checkin', 'checkout'],",
              "          properties: { checkin: { type: 'string' }, checkout: { type: 'string' } }",
              "        },",
              "        additionalneeds: { type: 'string' }",
              "      }",
              "    }",
              "  }",
              "};",
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('the body matches the schema', () => pm.response.to.have.jsonSchema(schema));",
              "const body = pm.response.json();",
              "pm.test('the booking echoes the payload', () =>",
              "  pm.expect(body.booking).to.eql(JSON.parse(pm.collectionVariables.get('payload'))));",
              "pm.collectionVariables.set('bookingId', body.bookingid);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{payload}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Booking: read what was created",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('the booking is the one created', () =>",
              "  pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get('payload'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        }
      }
    },
    {
      "name": "Booking: update without a token is forbidden",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"firstname\": \"Intruder\", \"lastname\": \"X\", \"totalprice\": 1, \"depositpaid\": false, \"bookingdates\": {\"checkin\": \"2026-11-01\", \"checkout\": \"2026-11-05\"}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Booking: full update with a token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('the changed fields are stored', () => {",
              "  pm.expect(body.firstname).to.eql('Bia');",
              "  pm.expect(body.totalprice).to.eql(200);",
              "  pm.expect(body.depositpaid).to.eql(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"firstname\": \"Bia\", \"lastname\": \"Newman\", \"totalprice\": 200, \"depositpaid\": false, \"bookingdates\": {\"checkin\": \"2026-11-01\", \"checkout\": \"2026-11-05\"}, \"additionalneeds\": \"Breakfast\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Booking: partial update with a token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('only the sent field changes', () => {",
              "  pm.expect(body.additionalneeds).to.eql('Late check-out');",
              "  pm.expect(body.firstname).to.eql('Bia');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"additionalneeds\": \"Late check-out\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Booking: delete with a token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('known defect BUG-010: answers 201 Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        }
      }
    },
    {
      "name": "Booking: read after delete returns 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        }
      }
    }
  ]
}
